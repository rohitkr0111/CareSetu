# CareSetu Hospital Intelligence Engine - Environment Configuration

# Server Port (Default: 5001 for standalone server, 3000 for Vite dev proxy)
PORT=5001

# Node Environment
NODE_ENV=production

# Hospital Node Identifier
HOSPITAL_NODE_ID=HOSP-IN-DEL-409
HOSPITAL_NAME="Apex Metro General Hospital & Trauma Centre"

# Database Storage Path (Optional, defaults to server/data/caresetu.db)
# DATABASE_PATH="./server/data/caresetu.db"

# Optional Gemini API Key for Advanced Natural Language Clinical Summaries
GEMINI_API_KEY=""
